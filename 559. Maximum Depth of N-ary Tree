"""
# Definition for a Node.
class Node(object):
    def __init__(self, val=None, children=None):
        self.val = val
        self.children = children
"""

class Solution(object):
    def maxDepth(self, root):
        if not root:
            return 0
        depth = 0
        for i in root.children:
            depth = max(depth,self.maxDepth(i))
        return 1+depth
