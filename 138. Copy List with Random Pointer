"""
# Definition for a Node.
class Node:
    def __init__(self, x, next=None, random=None):
        self.val = int(x)
        self.next = next
        self.random = random
"""
class Solution(object):
    def copyRandomList(self, head):
        if not head:
            return None
        mp = {}
        temp = head
        while temp:
            mp[temp] = Node(temp.val)
            temp = temp.next
        temp = head
        while temp:
            mp[temp].next = mp.get(temp.next)
            mp[temp].random = mp.get(temp.random)
            temp = temp.next
        return mp[head]
        
