class Solution(object):
    def gcdOfOddEvenSums(self, n):
        sumOdd,sumEven = 0,0
        for i in range(1, n + 1):
            sumOdd += 2 * i - 1
            sumEven += 2 * i
        if sumEven > sumOdd:
            while sumOdd!=0:
                sumEven,sumOdd = sumOdd,sumEven % sumOdd
            return sumEven
        else:
            while sumEven!=0:
                sumOdd,sumEven = sumEven,sumOdd % sumEven
            return sumOdd

        
