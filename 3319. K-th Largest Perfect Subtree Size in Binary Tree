#         self.val = val
#         self.left = left
#         self.right = right

class Solution(object):
    def kthLargestPerfectSubtree(self, root, k):
        res = []
        def dfs(node):
            if not node:
                return True, 0
            lp,ls = dfs(node.left)
            rp,rs = dfs(node.right)
            if lp and rp and ls == rs:
                size = ls + rs + 1
                res.append(size)
                return True, size
            return False, 0
        dfs(root)
        if k > len(res):
            return -1
        return res[k - 1]
