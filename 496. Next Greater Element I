class Solution(object):
    def nextGreaterElement(self, nums1, nums2):
        res = []
        for i in nums1:
            not_great = -1
            target_found = False
            for num in nums2:
                if num == i:
                    target_found = True
                elif target_found:
                    if num > i:
                        not_great = num
                        break
            res.append(not_great)
        return res
        
