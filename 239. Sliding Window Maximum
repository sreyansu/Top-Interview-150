class Solution(object):
    def maxSlidingWindow(self, nums, k):
        d=deque()
        res = []
        for i, n in enumerate(nums):
            while d and d[0] <= i-k:
                d.popleft()
            while d and nums[d[-1]] < n:
                d.pop()
            d.append(i)
            if i>= k-1:
                res.append(nums[d[0]])
        return res
        
