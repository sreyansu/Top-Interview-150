class Solution(object):
    def findRotation(self, mat, target):
        def DoRotation():
            for i in range(len(mat)):
                for j in range(i+1,len(mat)):
                    mat[i][j],mat[j][i] = mat[j][i],mat[i][j]
            for i in mat:
                i.reverse()
        
        for m in range(4):
            if mat == target:
                return True
            DoRotation()
        return False
